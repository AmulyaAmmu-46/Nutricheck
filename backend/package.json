{
    "name": "nuricheck-backend",
    "version": "1.0.0",
    "description": "Backend API for Nuricheck health and nutrition tracking system",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node server.js",
        "start:azure": "node server.js",
        "dev": "nodemon server.js",
        "install-deps": "npm install",
        "test": "node --test"
    },
    "keywords": [
        "health",
        "nutrition",
        "protein",
        "tracking",
        "mern"
    ],
    "author": "Shreyas",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.5.0",
        "nodemailer": "^7.0.0",
        "pdfkit": "^0.17.2"
    },
    "devDependencies": {
        "nodemon": "^3.1.0",
        "supertest": "^7.0.0"
    },
    "nodemonConfig": {
        "watch": [
            "server.js",
            "routes",
            "controllers",
            "models",
            "utils"
        ],
        "ext": "js,json",
        "ignore": [
            "node_modules"
        ],
        "delay": "500"
    },
    "engines": {
        "node": ">=18"
    }
}
